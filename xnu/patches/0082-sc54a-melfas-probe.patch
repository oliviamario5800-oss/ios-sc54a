--- a/bsd/dev/sweet_touch.c
+++ b/bsd/dev/sweet_touch.c
@@ -22,9 +22,15 @@
 extern void sweet_hid_touch(int finger, int down, int x, int y);
 void sweet_touch_init(void);
 
+#if defined(ARM64_BOARD_CONFIG_SC54A)
+#define TOUCH_SE_PA      0x00984000u /* Lito QUP SE7 (DT label qupv3_se7_i2c) */
+#define TOUCH_GCC_PA     0x00100000u
+#define TOUCH_NORTH_PA   0x0f000000u /* Lito TLMM, single region */
+#else
 #define TOUCH_SE_PA      0x00a84000u
 #define TOUCH_GCC_PA     0x00100000u
 #define TOUCH_NORTH_PA   0x03900000u /* DT TLMM + NORTH (0x500000) */
+#endif
 #define TOUCH_GCC_VOTE   0x5200cu
 #define TOUCH_RCG       0x18148u    /* wrapper1 LOCAL S1 = global SE7 */
 #define TOUCH_GPIO_CFG(n) ((uint32_t)(n) * 0x1000u)
@@ -136,6 +142,13 @@
 static bool
 touch_clocks(void)
 {
+#if defined(ARM64_BOARD_CONFIG_SC54A)
+	/* Probe build: the Lito GCC RCG layout is unverified, so write nothing
+	 * and inherit the S-Boot clock state. touch_se_init() below reports
+	 * whether that state is usable (fw proto + FIFO geometry checks). */
+	printf("SC54A TOUCH: clock setup skipped; inheriting S-Boot state\n");
+	return true;
+#endif
 	/* Vote on only wrapper1 and SE7, preserving other clock users. */
 	uint32_t mask = (0x0fu << 18) | (1u << 23);
 	touch_wr(st.gcc, TOUCH_GCC_VOTE, touch_rd(st.gcc, TOUCH_GCC_VOTE) | mask);
@@ -545,6 +558,46 @@
 	return true;
 }
 
+#if defined(ARM64_BOARD_CONFIG_SC54A)
+#define MMS_INFO_PRODUCT  0x0100u /* MIP4 INFO bank, product/model bytes */
+#define MMS_INFO_VERSION  0x0170u /* MIP4 INFO bank, IC id / fw version */
+
+/*
+ * SC54A (Galaxy A51 5G, SM7250/Lito) Melfas MSS100 probe. Stock DTBO
+ * (dtbo.img, fragment@150/163): compatible melfas,mms_ts at I2C 0x48 on
+ * QUP SE7; melfas,irq-gpio is TLMM GPIO9; the tsp_ldo_en rail is a fixed
+ * regulator switched by TLMM GPIO11 (no RPMh vote, no reset GPIO in DT).
+ * Step 2 scope: power the rail, read the INFO bank, log, stop. The event
+ * loop comes only after this probe proves the bus and the panel.
+ */
+static void
+touch_sc54a_probe(void)
+{
+	printf("SC54A TOUCH: before: gpio9 cfg=%#x io=%#x gpio11 cfg=%#x io=%#x\n",
+	    touch_rd(st.gpio, TOUCH_GPIO_CFG(9)), touch_rd(st.gpio, TOUCH_GPIO_IO(9)),
+	    touch_rd(st.gpio, TOUCH_GPIO_CFG(11)), touch_rd(st.gpio, TOUCH_GPIO_IO(11)));
+	touch_gpio(9, 0, 3, 3, false, false);	/* IRQ input, pull-up */
+	touch_gpio(11, 0, 0, 0, true, true);	/* tsp_ldo_en: rail on */
+	touch_wait(100);			/* IC boots from internal flash */
+	uint8_t info[16] = {0};
+	int ie = touch_read(0x48, MMS_INFO_PRODUCT, true, info, sizeof(info));
+	printf("SC54A TOUCH: melfas info err=%d data="
+	    "%02x %02x %02x %02x %02x %02x %02x %02x "
+	    "%02x %02x %02x %02x %02x %02x %02x %02x irq=%#x\n",
+	    ie, info[0], info[1], info[2], info[3], info[4], info[5], info[6],
+	    info[7], info[8], info[9], info[10], info[11], info[12], info[13],
+	    info[14], info[15], st.irq_status);
+	uint8_t ver[8] = {0};
+	int ve = touch_read(0x48, MMS_INFO_VERSION, true, ver, sizeof(ver));
+	printf("SC54A TOUCH: melfas version err=%d data="
+	    "%02x %02x %02x %02x %02x %02x %02x %02x irq=%#x\n",
+	    ve, ver[0], ver[1], ver[2], ver[3], ver[4], ver[5], ver[6], ver[7],
+	    st.irq_status);
+	printf("SC54A TOUCH: probe done; gpio9 io=%#x gpio11 io=%#x\n",
+	    touch_rd(st.gpio, TOUCH_GPIO_IO(9)), touch_rd(st.gpio, TOUCH_GPIO_IO(11)));
+}
+#endif /* ARM64_BOARD_CONFIG_SC54A */
+
 static void
 touch_thread(void *arg, wait_result_t result)
 {
@@ -569,6 +622,10 @@
 	if (!touch_clocks() || !touch_se_init()) {
 		goto out;
 	}
+#if defined(ARM64_BOARD_CONFIG_SC54A)
+	touch_sc54a_probe();
+	goto out;
+#endif
 	printf("SWEET TOUCH: TLMM reset=%#x irq=%#x vdd90=%#x; voting L11C through RPMh\n",
 	    touch_rd(st.gpio, TOUCH_GPIO_IO(8)), touch_rd(st.gpio, TOUCH_GPIO_IO(9)),
 	    touch_rd(st.gpio, TOUCH_GPIO_IO(90)));
